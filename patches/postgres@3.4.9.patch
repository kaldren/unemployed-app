index 07f6716702ac888215c86ad6e0071aaf55ae519c..3eba3f39248213272c5e4ea60563af3e1ba3b671 100644
--- a/cjs/src/connection.js
+++ b/cjs/src/connection.js
@@ -11,6 +11,13 @@ const Queue = require('./queue.js')
 const { Query, CLOSE } = require('./query.js')
 const b = require('./bytes.js')
 
+// Next.js 16 swaps in its own setImmediate while it renders, and drops callbacks queued in a render it
+// abandons. A dropped write flush leaves the connection waiting forever, so use Node's own timers.
+const nextTimers = () => globalThis[Symbol.for('next.fast-set-immediate.originals')]
+const nativeSetImmediate = fn => (nextTimers()?.setImmediate ?? setImmediate)(fn)
+const nativeClearImmediate = id => (nextTimers()?.clearImmediate ?? clearImmediate)(id)
+
+
 module.exports = Connection
 
 let uid = 1
@@ -247,13 +254,13 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
     chunk = chunk ? Buffer.concat([chunk, x]) : Buffer.from(x)
     if (fn || chunk.length >= 1024)
       return nextWrite(fn)
-    nextWriteTimer === null && (nextWriteTimer = setImmediate(nextWrite))
+    nextWriteTimer === null && (nextWriteTimer = nativeSetImmediate(nextWrite))
     return true
   }
 
   function nextWrite(fn) {
     const x = socket.write(chunk, fn)
-    nextWriteTimer !== null && clearImmediate(nextWriteTimer)
+    nextWriteTimer !== null && nativeClearImmediate(nextWriteTimer)
     chunk = nextWriteTimer = null
     return x
   }
@@ -424,7 +431,7 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
     if (stream || query || initial || sent.length)
       error(Errors.connection('CONNECTION_DESTROYED', options))
 
-    clearImmediate(nextWriteTimer)
+    nativeClearImmediate(nextWriteTimer)
     if (socket) {
       socket.removeListener('data', data)
       socket.removeListener('connect', connected)
@@ -437,7 +444,7 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
     incoming = Buffer.alloc(0)
     remaining = 0
     incomings = null
-    clearImmediate(nextWriteTimer)
+    nativeClearImmediate(nextWriteTimer)
     socket.removeListener('data', data)
     socket.removeListener('connect', connected)
     idleTimer.cancel()
