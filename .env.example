NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=                 # Supabase pooled connection string, used by Drizzle
SUPABASE_SERVICE_ROLE_KEY=      # Server/tests only (e2e test user). Never NEXT_PUBLIC_.
ANTHROPIC_API_KEY=              # Resume extraction and job drafting (Claude). Server only.
JOB_DRAFT_MODEL=                # Model that drafts and refines job posts. Defaults to claude-haiku-5-5. Server only.
MATCH_MODEL=                    # Model that scores job and candidate matches. Defaults to claude-sonnet-5-5. Server only.
VETTING_MODEL=                  # Model that vets new companies from their homepage. Defaults to claude-haiku-5-5. Server only.
ADMIN_USER_IDS=                 # Comma-separated Supabase user ids that can open /admin. Server only.
NEXT_PUBLIC_CONTACT_EMAIL=      # Shown on legal pages and to refused companies.
