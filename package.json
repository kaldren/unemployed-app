{
  "name": "unemployed-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db.mts && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed.mts --soft && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:e2e": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db.mts && playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "check": "pnpm verify && pnpm test:e2e",
    "demo:employer": "node scripts/demo-employer.mts",
    "seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed.mts",
    "db:use": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db.mts use",
    "db:reset": "supabase db reset && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db.mts",
    "db:stop": "supabase stop"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "free-email-domains": "^1.15.12",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.11.2"
}
